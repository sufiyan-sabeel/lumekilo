{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "22.23.2",
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_CONVEX_URL": "REPLACE_WITH_YOUR_CONVEX_URL",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "REPLACE_WITH_YOUR_CONVEX_SITE_URL"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}