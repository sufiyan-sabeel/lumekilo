{
  "expo": {
    "name": "LumeKilo",
    "slug": "lumekilo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "lumekilo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.lumekilo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "package": "com.lumekilo.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/images/logo.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your LumeKilo posts, stories, and profile.",
          "cameraPermission": "Take photos for your LumeKilo posts and stories.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "lumekilo",
          "organization": "lumekilo",
          "disableAutoUpload": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}